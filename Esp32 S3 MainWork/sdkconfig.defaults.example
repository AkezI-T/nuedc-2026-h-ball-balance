CONFIG_IDF_TARGET="esp32s3"

# ESP32-S3 N16R8
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y

# 16 MiB 自定义分区表
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# 双核分工：Core 0 负责系统与通信，Core 1 预留给实时控制
CONFIG_ESP_MAIN_TASK_AFFINITY_CPU0=y
CONFIG_ESP_TIMER_TASK_AFFINITY_CPU0=y
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_0=y
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y

# 8颗WS2812摄像头补光灯，GPIO21连接DIN
CONFIG_GRM_FILL_LIGHT_ENABLE=y
CONFIG_GRM_FILL_LIGHT_GPIO=21
CONFIG_GRM_FILL_LIGHT_LED_COUNT=8
CONFIG_GRM_FILL_LIGHT_BRIGHTNESS=64

# 与 K230 图传程序连接同一 Wi-Fi，凭据在本机 sdkconfig.defaults 中填写
CONFIG_GRM_WIFI_CONNECT_ENABLE=y
CONFIG_GRM_WIFI_SSID=""
CONFIG_GRM_WIFI_PASSWORD=""
CONFIG_GRM_WIFI_CONNECT_TIMEOUT_MS=15000

# K230视觉控制使用双向UART；TMX UART仅使用GPIO11/RX
CONFIG_GRM_VISION_UART_PORT=1
CONFIG_GRM_VISION_UART_RX_PIN=46
CONFIG_GRM_VISION_UART_TX_PIN=13
CONFIG_GRM_VISION_UART_BAUD=115200
CONFIG_GRM_TMX_UART_ENABLE=y
CONFIG_GRM_TMX_UART_PORT=2
CONFIG_GRM_TMX_UART_RX_PIN=11
CONFIG_GRM_TMX_UART_BAUD=115200
CONFIG_GRM_JY901S_I2C_ENABLE=y
CONFIG_GRM_JY901S_I2C_PORT=0
CONFIG_GRM_JY901S_I2C_SDA_PIN=16
CONFIG_GRM_JY901S_I2C_SCL_PIN=15
CONFIG_GRM_JY901S_I2C_CLOCK_HZ=100000
CONFIG_GRM_JY901S_X_BIAS_MG=15
CONFIG_GRM_JY901S_X_FILTER_DIVISOR=4

# 上位机通过固定 UDP 端口接收车载控制日志
CONFIG_GRM_UDP_LOG_ENABLE=y
CONFIG_GRM_UDP_LOG_HOST="255.255.255.255"
CONFIG_GRM_UDP_LOG_PORT=9011
